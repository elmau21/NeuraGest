{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "twitch-channel-viewer",
  "description": "Ventana secundaria para ver canales Twitch con sesión propia (conteo de view).",
  "windows": ["twitch-viewer-*"],
  "remote": {
    "urls": [
      "https://www.twitch.tv/*",
      "https://twitch.tv/*",
      "https://*.twitch.tv/*",
      "https://*.twitchcdn.net/*",
      "https://*.jtvnw.net/*"
    ]
  },
  "permissions": [
    "core:default"
  ]
}
