{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal (incluye UI servida por localhost en release).",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "store:default",
    "updater:default",
    "shell:allow-open",
    "allow-app-commands"
  ]
}
