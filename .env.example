# Frontend público (la publishable/anon key está protegida por RLS)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Backend Tauri únicamente. Nunca usar el secret con prefijo VITE_.
# Redirect OAuth Supabase (Twitch Developer Console + Supabase Auth → URL Configuration):
# https://dlnltlvydrruikvkgwlr.supabase.co/auth/v1/callback
# http://127.0.0.1:14563/auth/callback
# http://127.0.0.1:14564/auth/google/callback
TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID
TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET

# Google Calendar OAuth (Desktop app · Tauri backend)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Opcional: API key TwitchTracker si contratas acceso extendido (la API básica no la requiere)
TWITCHTRACKER_API_KEY=

# Firma del auto-updater (configurar antes de publicar releases)
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
