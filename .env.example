VITE_SUPABASE_URL=https://ehxnggopzftiolgapcav.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVoeG5nZ29wemZ0aW9sZ2FwY2F2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU5ODIwMDcsImV4cCI6MjEwMTU1ODAwN30.RrIrHI-waulcPQ0WFBzAzHrds4KwQGB_0auxqEYzIU8
# Backend Tauri únicamente. Nunca usar el secret con prefijo VITE_.
# Service role (solo backend Tauri / CI): Dashboard → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Redirect OAuth Supabase (Twitch Developer Console + Supabase Auth → URL Configuration):
# https://ehxnggopzftiolgapcav.supabase.co/auth/v1/callback
# http://127.0.0.1:14563/auth/callback
# http://127.0.0.1:14564/auth/google/callback
TWITCH_CLIENT_ID=YOUR_TWITCH_CLIENT_ID
TWITCH_CLIENT_SECRET=YOUR_TWITCH_CLIENT_SECRET

# Google Calendar OAuth (Desktop app · Tauri backend)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Opcional: API key TwitchTracker si contratas acceso extendido (la API básica no la requiere)
TWITCHTRACKER_API_KEY=

# Discord Rich Presence (defaults de agencia; no se editan desde Ajustes).
# Assets fijos: `neuragest` (large) y `neuragest_icon` (small) — ver assets/discord/.
DISCORD_APPLICATION_ID=1535443541634064424
# DISCORD_CLIENT_ID=

# Botones opcionales del Rich Presence (URLs reales).
# NEURALIVE_URL=https://…
# DISCORD_INVITE_URL=https://discord.gg/…

# Firma del auto-updater (configurar antes de publicar releases)
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Repo privado: PAT de solo lectura para descargar GitHub Releases desde la app
# Crear en GitHub → Settings → Developer settings → Fine-grained tokens → Contents: Read
VITE_GITHUB_RELEASES_TOKEN=

# VRChat Groups (API comunitaria — https://vrchatapi.github.io/)
# NO inventar passwords. Deja vacío hasta configurar el bot de sync.
# Preferible: cookie `auth` ya obtenida (evita límites de sesión).
VRCHAT_USERNAME=
VRCHAT_PASSWORD=
# Opcional: cookie auth=... (sin el prefijo "auth=")
VRCHAT_AUTH_COOKIE=
# Grupo Neura por defecto (público; no es secreto)
VRCHAT_GROUP_ID=grp_627b5237-b389-41eb-9eeb-c89233c8474c
